# Copia este archivo a ".env" (mismo folder) y pega ahí tu connection string real de Neon.
# En Neon: Dashboard → tu proyecto → "Connection string" → copiar (modo "Pooled connection").
DATABASE_URL=postgresql://usuario:contraseña@ep-xxxxx.neon.tech/neondb?sslmode=require

# Clave secreta para firmar las sesiones de inicio de sesión. Cualquier texto largo
# y aleatorio sirve — no lo compartas ni lo subas a GitHub (este archivo ya está
# excluido). En Render se genera solo, no hace falta ponerlo ahí a mano.
JWT_SECRET=cambia-esto-por-un-texto-largo-y-aleatorio

# Opcional — puerto local del backend (por default 4000)
PORT=4000
