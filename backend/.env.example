# Copia este archivo a ".env" (mismo folder) y pega ahí tu connection string real de Neon.
# En Neon: Dashboard → tu proyecto → "Connection string" → copiar (modo "Pooled connection").
DATABASE_URL=postgresql://usuario:contraseña@ep-xxxxx.neon.tech/neondb?sslmode=require

# Clave secreta para firmar las sesiones de inicio de sesión. Cualquier texto largo
# y aleatorio sirve — no lo compartas ni lo subas a GitHub (este archivo ya está
# excluido). En Render se genera solo, no hace falta ponerlo ahí a mano.
JWT_SECRET=cambia-esto-por-un-texto-largo-y-aleatorio

# Opcional — puerto local del backend (por default 4000)
PORT=4000

# Opcional — solo si vas a usar la conexión automática con Odoo (punto de
# venta) en vez de subir el Excel a mano en Auditoría. Si no lo llenas, esa
# parte simplemente no se activa y todo lo demás sigue igual.
ODOO_URL=https://pos.mifrutalyogurt.com
ODOO_DB=
ODOO_USERNAME=auditoria.inventarios@frutal.com
ODOO_API_KEY=

# Obligatoria para poder borrar cuadres de Auditoría o capturas de Cortes
# por día — sin esta variable, esos borrados quedan bloqueados (a propósito,
# para no dejar una contraseña fija en el código). Ponle aquí un texto largo
# y aleatorio tuyo; como vive solo en el servidor, nunca aparece en el código
# que se manda al navegador. En Render, agrégala también en sus variables de
# entorno (Environment) — este archivo no se sube ahí solo.
AI_CLAVE_BORRAR=cambia-esto-por-una-contraseña-tuya
